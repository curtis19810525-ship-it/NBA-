def fetch_team_stats_html(team_zh):
    info = ESPN_TEAM_MAPPING.get(team_zh)
    if not info:
        return None
    url = f"https://www.espn.com/nba/team/stats/_/name/{info['abbr']}/{info['name']}"
    try:
        r = requests.get(url, headers=HEADERS, timeout=20)
        r.raise_for_status()
        return r.text
    except Exception as e:
        print(f"  抓取失敗 {team_zh}: {e}")
        return None


def _headers_and_rows(table):
    """回傳 (headers, rows)；headers 是該表欄名，rows 是資料列(每列 list[str])"""
    headers = [th.get_text(strip=True) for th in table.find_all("th")]
    rows = []
    tbody = table.find("tbody") or table
    for tr in tbody.find_all("tr"):
        cells = tr.find_all(["td", "th"])
        if not cells:
            continue
        rows.append([c.get_text(strip=True) for c in cells])
    return headers, rows


def _last_data_row(rows):
    """取最後一列（通常為 Total）"""
    if not rows:
        return []
    return rows[-1]


def parse_team_total(html):
    """
    解析 ESPN 統計頁，回傳欄位字典：
    GP, GS, MIN, PTS, OR, REB, AST, STL, BLK, TO, PF, AST/TO,
    FGM, FGA, FG%, 3PM, 3PA, 3P%, FTM, FTA, FT%, 2PM, 2PA, 2P%, SC-EFF, SH-EFF
    """
    soup = BeautifulSoup(html, "html.parser")
    tables = soup.find_all("table")
    if len(tables) < 4:
        return {}

    # 常見結構：
    # table0: name-only (Player Stats)
    # table1: numeric (Player Stats)
    # table2: name-only (Shooting)
    # table3: numeric (Shooting)
    h_stats, rows_stats = _headers_and_rows(tables[1])
    h_shoot, rows_shoot = _headers_and_rows(tables[3])

    vals_stats = _last_data_row(rows_stats)
    vals_shoot = _last_data_row(rows_shoot)

    # 以 headers 對齊值，避免欄位順序小變動
    stats_map = {}
    if h_stats and vals_stats:
        # 有些頁面 header 數量可能 > values，取可對齊長度
        n = min(len(h_stats), len(vals_stats))
        for i in range(n):
            k = h_stats[i].upper()
            stats_map[k] = vals_stats[i]

    shoot_map = {}
    if h_shoot and vals_shoot:
        n = min(len(h_shoot), len(vals_shoot))
        for i in range(n):
            k = h_shoot[i].upper()
            shoot_map[k] = vals_shoot[i]

    # 統一輸出欄位
    out = {
        "GP": stats_map.get("GP", ""),
        "GS": stats_map.get("GS", ""),
        "MIN": stats_map.get("MIN", ""),
        "PTS": stats_map.get("PTS", ""),
        "OR": stats_map.get("OR", ""),
        "REB": stats_map.get("REB", ""),
        "AST": stats_map.get("AST", ""),
        "STL": stats_map.get("STL", ""),
        "BLK": stats_map.get("BLK", ""),
        "TO": stats_map.get("TO", ""),
        "PF": stats_map.get("PF", ""),
        "AST/TO": stats_map.get("AST/TO", ""),
        "FGM": shoot_map.get("FGM", ""),
        "FGA": shoot_map.get("FGA", ""),
        "FG%": shoot_map.get("FG%", ""),
        "3PM": shoot_map.get("3PM", ""),
        "3PA": shoot_map.get("3PA", ""),
        "3P%": shoot_map.get("3P%", ""),
        "FTM": shoot_map.get("FTM", ""),
        "FTA": shoot_map.get("FTA", ""),
        "FT%": shoot_map.get("FT%", ""),
        "2PM": shoot_map.get("2PM", ""),
        "2PA": shoot_map.get("2PA", ""),
        "2P%": shoot_map.get("2P%", ""),
        "SC-EFF": shoot_map.get("SC-EFF", ""),
        "SH-EFF": shoot_map.get("SH-EFF", ""),
    }
    return out


def ensure_sheet(wb, name):
    if name not in wb.sheetnames:
        wb.create_sheet(name)
    return wb[name]


def write_totals_to_excel(rows):
    wb = load_workbook(NBA_STATS_FILE)
    ws = ensure_sheet(wb, "各隊total")

    # 第2列起清空
    for r in range(ws.max_row, 1, -1):
        ws.delete_rows(r)

    # 寫入資料（A~AB）
    # A 球隊名稱, B NAME/姓名(固定 Total), C~AB 與球員狀態一致
    for i, row in enumerate(rows, start=2):
        for j, v in enumerate(row, start=1):
            ws.cell(row=i, column=j, value=v)

    wb.save(NBA_STATS_FILE)


