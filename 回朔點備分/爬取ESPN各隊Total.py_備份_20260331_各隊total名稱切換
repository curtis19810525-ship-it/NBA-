            # 空值列也照樣寫，避免少隊伍導致定位混亂
            out_rows.append([team, "Total"] + [""] * 26)
            continue

        t = parse_team_total(html)
        row = [
            team, "Total",
            t.get("GP", ""), t.get("GS", ""), t.get("MIN", ""), t.get("PTS", ""),
            t.get("OR", ""), t.get("REB", ""), t.get("AST", ""), t.get("STL", ""),
            t.get("BLK", ""), t.get("TO", ""), t.get("PF", ""), t.get("AST/TO", ""),
            t.get("FGM", ""), t.get("FGA", ""), t.get("FG%", ""), t.get("3PM", ""),
            t.get("3PA", ""), t.get("3P%", ""), t.get("FTM", ""), t.get("FTA", ""),
            t.get("FT%", ""), t.get("2PM", ""), t.get("2PA", ""), t.get("2P%", ""),
            t.get("SC-EFF", ""), t.get("SH-EFF", ""),
        ]
        out_rows.append(row)

    write_totals_to_excel(out_rows)
    print("完成：已寫入分頁「各隊total」。")
    return 0


if __name__ == "__main__":
    sys.exit(main())

