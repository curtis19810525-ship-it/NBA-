# -*- coding: utf-8 -*-
"""
Crawler + OX + Team Stats (All-in-One)
"""
import os
import sys
import subprocess

def main():
    base_dir = os.path.dirname(os.path.abspath(__file__))
    os.chdir(base_dir)

    print("=" * 60)
    print("Crawler + OX + Team Stats (All-in-One)")
    print("=" * 60)
    print()
    print("Please close Excel before running.")
    print()

    try:
        start = input("Enter Start Date (YYYYMMDD, e.g. 20251022): ").strip()
        end = input("Enter End Date (YYYYMMDD, e.g. 20260214): ").strip()
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        return 1

    if not start or not end:
        print("Error: Start and end date are required.")
        return 1

    date_range = f"{start}~{end}"
    results = []

    print()
    print("=" * 60)
    print("Step 1/3: Crawler")
    print("=" * 60)
    r1 = subprocess.run(
        [sys.executable, "執行範圍爬蟲.py", start, end],
        cwd=base_dir
    )
    results.append(("Crawler", r1.returncode))

    print()
    print("=" * 60)
    print("Step 2/3: Batch Convert OX")
    print("=" * 60)
    r2 = subprocess.run(
        [sys.executable, "批次轉換正負盤.py", date_range],
        cwd=base_dir
    )
    results.append(("OX", r2.returncode))

    print()
    print("=" * 60)
    print("Step 3/3: Batch Convert Team Stats")
    print("=" * 60)
    r3 = subprocess.run(
        [sys.executable, "批次轉換各隊正負.py", date_range],
        cwd=base_dir
    )
    results.append(("Team Stats", r3.returncode))

    print()
    print("=" * 60)
    print("Summary")
    print("=" * 60)
    for name, code in results:
        status = "OK" if code == 0 else "FAILED"
        print(f"Step {name}: {status}")
    print("=" * 60)
    return 0

if __name__ == "__main__":
    sys.exit(main())
